# ============================================
# Claudeus WordPress AI Assistant SaaS v2
# Environment Variables
# ============================================

# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# OpenAI API (REQUIRED - v2 architecture)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Assistant ID created on platform.openai.com/assistants (REQUIRED)
# Create your assistant with execute_wordpress_action function
OPENAI_ASSISTANT_ID="asst_your-assistant-id-here"

# ============================================
# JWT Secrets (REQUIRED)
# ============================================
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production-at-least-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-at-least-32-chars"

# ============================================
# Encryption Key (REQUIRED - EXACTLY 32 CHARACTERS!)
# ============================================
# Used to encrypt WordPress credentials and MCP JWT tokens
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY="changeme32charactersencryptionk"

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://claudeus:claudeus_password_change_in_prod@localhost:5432/claudeus_wp_saas"

# ============================================
# Redis Cache
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# Stripe (Optional - for subscription management)
# ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# SMTP Email (Optional - for notifications)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Claudeus AI <noreply@claudeus.ai>"

# ============================================
# Application Configuration
# ============================================
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# ============================================
# Logging
# ============================================
LOG_LEVEL="info"  # error, warn, info, debug

# ============================================
# How to generate secure secrets:
# ============================================
#
# On Linux/Mac:
#   openssl rand -base64 32    # For JWT secrets
#   openssl rand -hex 16       # For encryption key (32 chars)
#
# On Windows (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Online generator:
#   https://generate-secret.vercel.app/32
