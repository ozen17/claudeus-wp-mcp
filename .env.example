# WordPress MCP Configuration (for local development)
WP_SITES_PATH=/Users/amadeus/credentials/wp-sites.json
DEFAULT_SITE=default_test

# ============================================
# SAAS CONFIGURATION
# ============================================

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production-at-least-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-at-least-32-chars"

# Encryption Key (MUST BE EXACTLY 32 CHARACTERS!)
ENCRYPTION_KEY="changeme32charactersencryptionk"

# Database
DATABASE_URL="postgresql://claudeus:claudeus_password_change_in_prod@localhost:5432/claudeus_wp_saas"

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe (Payment Processing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SMTP (Optional for email notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Claudeus AI <noreply@claudeus.ai>"

# Application
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"
MCP_SERVER_URL="http://localhost:3002"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Logging
LOG_LEVEL="info"