// Prisma schema v2 for Claudeus WordPress AI Assistant SaaS
// Architecture: Agent OpenAI + MCP WordPress Plugin

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?

  // Authentication
  emailVerified Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  isAdmin       Boolean  @default(false)  // Admin users can configure OpenAI key

  // Subscription
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // Relations
  sites         Site[]
  conversations Conversation[]
  sessions      Session[]
  usageLogs     UsageLog[]
  auditLogs     AuditLog[]

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String   @unique
  accessToken  String   @unique

  ipAddress    String?
  userAgent    String?

  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ============================================
// Subscription Management
// ============================================

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model Subscription {
  id              String             @id @default(cuid())

  tier            SubscriptionTier   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)

  // Stripe integration
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?

  // Usage limits
  maxSites        Int    @default(1)
  maxRequests     Int    @default(50)

  // Billing
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Relations
  users           User[]

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscriptions")
}

// ============================================
// WordPress Sites with MCP Plugin
// ============================================

model Site {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Site details
  name        String
  url         String

  // MCP Plugin authentication (JWT token from WordPress MCP plugin)
  mcpJwtToken         String?   // Encrypted JWT token
  mcpJwtTokenIv       String?   // IV for encryption
  mcpPluginVersion    String?   // Version of installed MCP plugin

  // MCP Tools configuration (which tools are enabled for this site)
  enabledMcpTools     String[]  @default([]) // Array of enabled tool IDs (ex: ["wordpress_create_post", "wordpress_list_posts"])

  // Legacy auth (for migration period)
  username    String?
  passwordEncrypted String?
  passwordIv        String?
  authType    String   @default("mcp") // "mcp" or "basic" (legacy)

  // Status
  isActive    Boolean  @default(true)
  lastChecked DateTime?
  isHealthy   Boolean  @default(true)

  // Relations
  conversations Conversation[]
  policy        SitePolicy?
  auditLogs     AuditLog[]

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("sites")
}

// ============================================
// Tool Categories & Policies (v2)
// ============================================

enum ToolCategoryType {
  APPEARANCE_THEMES   // Thèmes, customizer, FSE
  MENUS              // Navigation, menus
  CONTENT            // Articles, pages, taxonomies
  MEDIA              // Images, fichiers
  WOOCOMMERCE        // Produits, commandes, clients
  USERS              // Utilisateurs, rôles
  SETTINGS           // Options, configuration
}

enum PolicyAction {
  READ      // Lire, consulter
  CREATE    // Créer
  UPDATE    // Modifier
  DELETE    // Supprimer
  PUBLISH   // Publier (pour content)
}

model SitePolicy {
  id          String       @id @default(cuid())
  siteId      String       @unique
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Global settings
  requireConfirmDelete Boolean @default(true)  // Toujours demander confirmation pour DELETE
  defaultEnabled       Boolean @default(true)  // Par défaut, tout est activé

  rules       PolicyRule[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("site_policies")
}

model PolicyRule {
  id              String            @id @default(cuid())
  sitePolicyId    String
  sitePolicy      SitePolicy        @relation(fields: [sitePolicyId], references: [id], onDelete: Cascade)

  category        ToolCategoryType
  isEnabled       Boolean           @default(true)  // Catégorie activée/désactivée

  // Actions autorisées (array JSON)
  allowedActions  String[]          @default([])    // ["READ", "CREATE", "UPDATE"]

  // Contraintes optionnelles par catégorie
  maxOpsPerDay    Int?              // Max opérations par jour (null = illimité)

  // Contraintes WooCommerce
  minPrice        Decimal?          @db.Decimal(10, 2)
  maxPrice        Decimal?          @db.Decimal(10, 2)

  // Contraintes Content
  maxPublishPerDay Int?             // Max publications par jour

  requireConfirm  Boolean           @default(false) // Demander confirmation pour cette catégorie

  metadata        Json?             // Contraintes additionnelles flexibles

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([sitePolicyId, category])
  @@index([sitePolicyId])
  @@map("policy_rules")
}

// ============================================
// Conversations & Chat (OpenAI only)
// ============================================

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  title       String

  // OpenAI Agent configuration
  agentId     String?  // ID de l'Agent OpenAI (Assistants API v2)
  model       String   @default("gpt-4o")

  // Relations
  messages    Message[]

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastMessageAt DateTime?

  @@index([userId])
  @@index([siteId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String       // "user", "assistant", "system"
  content        String       @db.Text

  // Tool calls (MCP) - stockés pour audit
  toolCalls      Json?
  toolResults    Json?

  // Tokens
  promptTokens   Int?
  completionTokens Int?
  totalTokens    Int?

  // Metadata
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ============================================
// Audit Trail
// ============================================

model AuditLog {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  category        ToolCategoryType
  action          PolicyAction
  toolName        String           // Nom de l'outil MCP appelé (ex: "wc.products.create")

  // Intent & résultat
  intent          String           @db.Text  // Ce que l'utilisateur a demandé
  result          String           @db.Text  // Résultat de l'action
  success         Boolean

  // Diff WordPress (optionnel)
  beforeState     Json?            // État avant
  afterState      Json?            // État après

  metadata        Json?            // Données supplémentaires

  createdAt       DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([siteId, createdAt])
  @@index([category])
  @@map("audit_logs")
}

// ============================================
// Usage Tracking
// ============================================

enum UsageType {
  AI_REQUEST      // Requête à l'Agent OpenAI
  MCP_TOOL_CALL   // Appel d'outil MCP
  API_CALL        // Appel API général
}

model UsageLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        UsageType

  // AI usage (OpenAI only now)
  model       String?
  promptTokens   Int?
  completionTokens Int?
  totalTokens    Int?

  // Cost tracking (based on OpenAI pricing)
  estimatedCost Decimal? @db.Decimal(10, 6)

  // Request details
  endpoint    String?
  method      String?
  statusCode  Int?
  responseTime Int?    // milliseconds

  // Metadata
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("usage_logs")
}

// ============================================
// System Configuration
// ============================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json

  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
